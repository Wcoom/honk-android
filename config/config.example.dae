dns {
  ipversion_prefer: 4
  optimistic_cache: true
  upstream {
    # 公共加密 DNS（IP 直连免 bootstrap；可按需替换为自建 DoH / h3:// DoH3 / tls:// DoT）
    alidns_doh: 'https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com' -> direct
    dnspod_doh: 'https://1.12.12.12/dns-query?tls_server_name=doh.pub' -> direct
    alidns_dot: 'tls://223.5.5.5:853?tls_server_name=dns.alidns.com' -> direct
    bootstrap_udp: 'udp://223.5.5.5:53' -> direct
    google_doh: 'https://8.8.8.8/dns-query?tls_server_name=dns.google' -> 总模式
  }
  routing {
    request {
      # 屏蔽 HTTPS/SVCB 记录（返回 NODATA），避免 Cloudflare ECH 外层 SNI 错配
      qtype(https) -> reject
      # 若使用域名形式的节点服务器或自建 DoH/DoT，请将对应主域名加入下方直连 bootstrap，防止解析回环
      qname(suffix:alidns.com, suffix:doh.pub) -> bootstrap_udp
      qname(geosite:private, suffix:lan, suffix:localdomain, suffix:example, suffix:invalid, suffix:localhost, suffix:test, suffix:local, suffix:home.arpa) -> asis
      # 国内及融合白名单域名走国内加密 DNS，其余海外域名走代理 DoH
      qname(geosite:merged-lan, geosite:surfing-direct, geosite:merged-cn-mirror, geosite:merged-bilibili, geosite:merged-douyin, geosite:merged-xiaohongshu, geosite:merged-chinamedia, geosite:merged-cn, geosite:merged-googlefcm) -> alidns_doh
      fallback: google_doh
    }
    response {
      fallback: accept
    }
  }
}

routing {
  # 1) USB 热点免劫持 + 私网/局域网/NTP/Surfing IMS 放行（!dport(53) 保留透明 DNS 接管）
  pname('dnsmasq') -> direct(must)
  sip(192.168.42.0/24) -> direct(must)
  dip(geoip:private, geoip:merged-lan-ip, 100.64.0.0/10, 224.0.0.0/4, 255.255.255.255/32) && !dport(53) -> direct(must)
  domain(geosite:merged-lan, geosite:surfing-direct) -> direct

  # 2) Play 下载 CDN 直连修正 + Google 核心域名代理 + WebRTC 拒连防泄漏
  domain(suffix:xn--ngstr-lra8j.com, suffix:gvt1.com) -> direct
  domain(suffix:google.com, suffix:googleapis.com, suffix:googleusercontent.com, suffix:gstatic.com, suffix:ggpht.com) -> Google
  domain(geosite:merged-webrtc) -> WebRTC
  dip(geoip:merged-webrtc-ip) -> WebRTC
  dport(19302, 3478, 5349, 10000, 5350) -> WebRTC

  # 3) 广告 / 运营商劫持 / HttpDNS 拦截（MetaCubeX + Surfing AWAvenue + bm7 AdvertisingLite/Hijacking/BlockHttpDNS）
  domain(geosite:merged-ads) -> 广告拦截
  dip(geoip:merged-ads-ip) -> 广告拦截

  # 4) 大陆内 App 与高优先级国内直连（置于海外规则之前；均按 15 字节内前缀编写以适配 Android eBPF 指令上限）
  pname('com.ss.android.') -> 抖音
  domain(geosite:merged-douyin) -> 抖音
  pname('com.xingin.xhs') -> 小红书
  domain(geosite:merged-xiaohongshu) -> 小红书
  pname('tv.danmaku.bili') -> 哔哩哔哩
  domain(geosite:merged-bilibili) -> 哔哩哔哩

  # 紧凑前缀覆盖主流大陆 App（不含 Chrome 等通用浏览器；其余大陆 App 由 merged-cn + geoip:cn 自动直连）
  pname('com.tencent.', 'com.eg.android', 'com.taobao.', 'com.jingdong', 'com.xunmeng', 'com.sankuai', 'com.sdu.didi', 'com.autonavi', 'com.baidu.', 'com.deepseek', 'com.alibaba', 'com.heytap.', 'com.oplus.', 'com.coloros.') -> 国内直连名单

  # 跨国大厂国内镜像 / 游戏国内下载 CDN / PT / 国内影音直连
  domain(geosite:merged-cn-mirror, geosite:merged-chinamedia) -> 国内直连名单

  # 5) 大陆外专属服务与常见海外 App → 代理策略组
  pname('com.pikcloud.pi') -> PikPak
  domain(geosite:merged-pikpak) -> PikPak
  domain(geosite:merged-openai) -> OpenAI
  domain(geosite:merged-ai) -> AI
  pname('com.openai.chat') -> AI
  domain(geosite:merged-github) -> GitHub
  domain(geosite:merged-emby) -> Emby
  pname('com.mb.android') -> Emby
  domain(geosite:merged-ehentai) -> E-hentai
  domain(geosite:merged-pixiv) -> Pixiv
  domain(geosite:merged-discord) -> Discord
  domain(geosite:merged-tiktok) -> TikTok
  domain(geosite:merged-twitter) -> Twitter(X)
  pname('com.twitter.and') -> Twitter(X)
  domain(geosite:merged-telegram) -> Telegram
  pname('org.telegram.me') -> Telegram
  domain(geosite:merged-googlefcm) -> GoogleFCM
  domain(geosite:merged-youtube) -> YouTube
  domain(geosite:merged-google) -> Google
  pname('com.instagram.a') -> Instagram
  domain(geosite:merged-instagram) -> Instagram
  domain(geosite:merged-netflix) -> Netflix
  domain(geosite:merged-spotify) -> Spotify
  domain(geosite:merged-steam) -> Steam
  domain(geosite:merged-apple) -> Apple
  domain(geosite:merged-microsoft) -> Microsoft
  domain(geosite:merged-facebook) -> Facebook

  # 其余全面覆盖的大陆外服务（港台亚洲媒体/海外流媒体/开发学术/社交/国际游戏/支付加密/海外云）→ 海外代理名单
  domain(geosite:merged-asianmedia, geosite:merged-media-other, geosite:merged-dev-other, geosite:merged-social-other, geosite:merged-games-other, geosite:merged-tech-other) -> 海外代理名单

  # 6) 大陆全量域名直连（7 源融合去重，已扣减强海外核心域）
  domain(geosite:merged-cn) -> 国内直连名单

  # 7) 海外全量域名代理（已扣减大陆及前序专属桶冗余）
  domain(geosite:merged-overseas) -> 海外代理名单

  # 8) GeoIP 精细分流（置于域名规则之后，确保 SNI 嗅探优先）
  dip(geoip:merged-telegram-ip) -> Telegram
  dip(geoip:merged-twitter-ip) -> Twitter(X)
  dip(geoip:merged-openai-ip) -> OpenAI
  dip(geoip:merged-ai-ip) -> AI
  dip(geoip:merged-youtube-ip) -> YouTube
  dip(geoip:merged-googlefcm-ip) -> GoogleFCM
  dip(geoip:merged-google-ip) -> Google
  dip(geoip:merged-netflix-ip) -> Netflix
  dip(geoip:merged-spotify-ip) -> Spotify
  dip(geoip:merged-facebook-ip) -> Facebook
  dip(geoip:merged-apple-ip) -> Apple
  dip(geoip:merged-ehentai-ip) -> E-hentai
  dip(geoip:merged-asianmedia-ip, geoip:merged-overseas-ip) -> 海外代理名单
  dip(geoip:merged-bilibili-ip) -> 哔哩哔哩
  # 7 源超网聚合去重的大陆 IPv4 + IPv6（MetaCubeX + Hackl0us + X-Shelby + clang IPv6 + IPinfo Lite CN + bm7）
  dip(geoip:cn) -> 国内直连名单

  # 9) DoT 端口 853 与最终兜底（未命中大陆规则一律走节点）
  dport(853) -> DNS连接
  fallback: 漏网之鱼
}

experimental {
  # 供 BoxProxy 原生「面板」与首页延迟/网速监控使用（仅监听本机回环）
  clash_api {
    external_controller: '127.0.0.1:9090'
    secret: ''
    default_mode: Rule
  }
  # 供 BoxProxy「WebUI」直接打开 honk 原生 Doona 面板（已内嵌至二进制，无需额外前端文件）
  native_api {
    enabled: true
    listen: '127.0.0.1:9527'
    allow_anonymous_loopback: true
    config_write: true
    ui: 'embedded'
  }
  cache_file {
    enabled: true
    store_dns: true
  }
}

# 指向云端 Wcoom/honk-rules-dat 的 release 直链分支（HTTP 200 无 302 重定向；honk 不跟随 302）；
# GitHub Actions 每天北京时间 00:00 / 12:00 自动融合 7 源并更新；Android 端 honk 按 UTC 计算 cron，
# 20 4,16 * * * 对应北京时间 12:20 与 00:20（另带随机抖动），自动拉取并校验 .sha256sum。
assets {
  geodata {
    geosite: 'https://raw.githubusercontent.com/Wcoom/honk-rules-dat/release/geosite.dat'
    geoip: 'https://raw.githubusercontent.com/Wcoom/honk-rules-dat/release/geoip.dat'
    route: 总模式
    auto_update: true
    cron: '20 4,16 * * *'
    checksum: true
  }
}
