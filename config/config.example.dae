  小红书 {
    policy: select
    filter: group('总模式', '智能策略 / ALL', '延迟最低', '故障转移', '负载均衡', '香港节点', '台湾节点', '狮城节点', '日本节点', '美国节点', '手动选择')
    filter: name('direct', 'block')
    default: direct
  }
  哔哩哔哩 {
    policy: select
    filter: group('总模式', '智能策略 / ALL', '延迟最低', '故障转移', '负载均衡', '香港节点', '台湾节点', '狮城节点', '日本节点', '美国节点', '手动选择')
    filter: name('direct', 'block')
    default: direct
  }

  # ── 常用海外服务独立策略组（默认跟随总模式）──────────────────────────
  OpenAI {
    policy: select
    filter: group('总模式', '智能策略 / ALL', '延迟最低', '故障转移', '负载均衡', '香港节点', '台湾节点', '狮城节点', '日本节点', '美国节点', '手动选择')
    filter: name('direct', 'block')
    default: '总模式'
  }
