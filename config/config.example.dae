# Honk for Android 全功能 7 源融合分流配置模板（已完全脱敏）
#
# 特性：
# - 配套云端 7 源融合去重规则库 Wcoom/honk-rules-dat（MetaCubeX + blackmatrix7 + Surfing/AWAvenue
#   + Hackl0us + ispip.clang.cn IPv6 + X-Shelby + IPinfo Lite CN），每天 00:00 / 12:00 CST 自动构建
# - 大陆 App / 域名 / IPv4+IPv6 直连，大陆外服务精细分组代理，广告/劫持/HttpDNS 拦截，WebRTC 拒连防泄漏
# - 已针对 Android eBPF 32767 指令跳转上限优化 pname 紧凑前缀（单配置建议保持 <=24 个 pname 模式）
#
# 使用方式：
# 1. 在 node { ... } 中替换为你的真实节点，或取消注释 subscription { ... } 填入订阅链接；
# 2. 按需在 dns.upstream { ... } 中替换为自建 DoH / DoH3 / DoT 地址；
# 3. 首次部署请将配套 geosite.dat 与 geoip.dat 放入 global.data_dir 目录：
#      https://raw.githubusercontent.com/Wcoom/honk-rules-dat/release/geosite.dat
#      https://raw.githubusercontent.com/Wcoom/honk-rules-dat/release/geoip.dat
# 4. 将本文件复制为 /data/user/0/com.boxproxy.honk/files/box/honk/config.dae 并在 BoxProxy Honk 中启用。

global {
  tproxy_port: 12345
  log_level: info
  wan_interface: auto
  auto_config_kernel_parameter: true
  dial_mode: domain++
  # 首项使用支持 HTTPS/HTTP3 (QUIC) 的探测地址以同时启用节点评分 QUIC 探测
  tcp_check_url: 'https://cp.cloudflare.com/generate_204', 'http://connectivitycheck.platform.hicloud.com/generate_204'
  tcp_check_http_method: HEAD
  udp_check_dns: 'dns.google:53', '1.1.1.1:53'
  check_interval: 3600s
  check_tolerance: 50ms
  tls_implementation: utls
  utls_imitate: chrome_auto
  allow_insecure: false
  nfqueue_enable: false
  # Android 无 /etc/resolv.conf，强烈建议同时配置主/备直连 Bootstrap DNS
  bootstrap_resolver: '223.5.5.5:53'
  fallback_resolver: '119.29.29.29:53'
  data_dir: '/data/user/0/com.boxproxy.honk/files/box/honk/data'
  preconnect_node_count: 2
  udp_warm_node_count: 2
}

# 可选：订阅配置（取消注释并替换为你的订阅链接）
# subscription {
#   my_sub: 'https://example.com/your-subscription-url' {
#     interval: 86400s
#     route: direct
#   }
# }

node {
  # 示例节点（请替换为实际节点链接；保留地区命名便于下方地区策略组自动归类）
  '🇭🇰 Hong Kong 01': 'anytls://your-password@hk.example.com:443/?sni=hk.example.com'
  '🇹🇼 Taiwan 01': 'anytls://your-password@tw.example.com:443/?sni=tw.example.com'
  '🇸🇬 Singapore 01': 'anytls://your-password@sg.example.com:443/?sni=sg.example.com'
  '🇯🇵 Japan 01': 'anytls://your-password@jp.example.com:443/?sni=jp.example.com'
  '🇺🇸 USA 01': 'anytls://your-password@us.example.com:443/?sni=us.example.com'
  # 自建 VLESS + XHTTP (CDN) 节点示例
  '🌐 Example CDN': 'vless://00000000-0000-0000-0000-000000000000@cdn.example.com:443?encryption=none&security=tls&type=xhttp&sni=cdn.example.com&host=cdn.example.com&fp=chrome&alpn=h2&path=%2Fapi%2Fv1%2Fstream&mode=stream-one'
}

group {
  # ── 通用自动策略组 ─────────────────────────────────────────────────────
  智能策略 / ALL {
    policy: score
    filter: !name('direct', 'block')
  }
  延迟最低 {
    policy: urltest
    filter: !name('direct', 'block')
  }
  故障转移 {
    policy: fallback
    filter: !name('direct', 'block')
  }
  负载均衡 {
    policy: loadbalance
    filter: !name('direct', 'block')
  }

  # ── 地区自动优选组（按节点名正则自动归类）────────────────────────────
  香港节点 {
    policy: score
    filter: name(regex: '(港|HK|hk|Hong Kong|HongKong|hongkong)')
  }
  台湾节点 {
    policy: score
    filter: name(regex: '(台|新北|彰化|TW|Taiwan)')
  }
  狮城节点 {
    policy: score
    filter: name(regex: '(新加坡|坡|狮城|SG|Singapore)')
  }
  日本节点 {
    policy: score
    filter: name(regex: '(日本|川日|东京|大阪|泉日|埼玉|沪日|深日|JP|Japan)')
  }
  美国节点 {
    policy: score
    filter: name(regex: '(美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|America|US|United States)')
  }

  # ── 手动与主控出口组 ───────────────────────────────────────────────────
  手动选择 {
    policy: select
    filter: !name('direct', 'block')
  }
  总模式 {
    policy: select
    filter: group('智能策略 / ALL', '香港节点', '台湾节点', '狮城节点', '日本节点', '美国节点', '延迟最低', '故障转移', '负载均衡', '手动选择')
    filter: name('direct', 'block')
    default: '智能策略 / ALL'
  }

  # ── 基础分流与拦截控制组 ───────────────────────────────────────────────
  国内直连名单 {
    policy: select
    filter: group('总模式', '智能策略 / ALL', '延迟最低', '故障转移', '负载均衡', '香港节点', '台湾节点', '狮城节点', '日本节点', '美国节点', '手动选择')
    filter: name('direct', 'block')
    default: direct
  }
  海外代理名单 {
    policy: select
    filter: group('总模式', '智能策略 / ALL', '延迟最低', '故障转移', '负载均衡', '香港节点', '台湾节点', '狮城节点', '日本节点', '美国节点', '手动选择')
    filter: name('direct', 'block')
    default: '总模式'
  }
  广告拦截 {
    policy: select
    filter: name('direct', 'block')
    default: block
  }
  WebRTC {
    policy: select
    filter: name('direct', 'block')
    default: block
  }
  DNS连接 {
    policy: select
    filter: group('总模式', '智能策略 / ALL', '延迟最低', '故障转移', '负载均衡', '香港节点', '台湾节点', '狮城节点', '日本节点', '美国节点', '手动选择')
    filter: name('direct', 'block')
    default: '总模式'
  }

  # ── 常用大陆应用独立策略组（默认直连，按需切节点）────────────────────
  抖音 {
    policy: select
    filter: group('总模式', '智能策略 / ALL', '延迟最低', '故障转移', '负载均衡', '香港节点', '台湾节点', '狮城节点', '日本节点', '美国节点', '手动选择')
    filter: name('direct', 'block')
    default: direct
