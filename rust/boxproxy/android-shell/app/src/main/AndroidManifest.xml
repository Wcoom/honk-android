<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exact 14 permissions matching com.boxproxy.honk v214 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <application
        android:name=".AppApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_default"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BoxProxyHonk"
        android:usesCleartextTraffic="true">

        <!-- Main Activity (launched via MainLauncherDefault / MainLauncherAlternate aliases) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 2 Launcher Icon Aliases -->
        <activity-alias
            android:name=".MainLauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_default"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainLauncherAlternate"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_alternate"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Translucent Quick Panel Sheet (M56) -->
        <activity
            android:name=".PanelSheetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.BoxProxyHonk.TranslucentPopup" />

        <!-- 4 Quick Settings Tile Long-Press Aliases (M46/M55) -->
        <activity-alias
            android:name=".BoxTilePreferencesDefaultActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_launcher_default"
            android:targetActivity=".PanelSheetActivity">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".BoxTilePreferencesAlternateActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_alternate"
            android:targetActivity=".PanelSheetActivity">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".BoxTilePreferencesWebUiActivity"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".BoxTilePreferencesAppActivity"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity-alias>

        <!-- External Core Import Activity (M38) -->
        <activity
            android:name=".CoreImportActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.BoxProxyHonk.TranslucentPopup">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Quick Settings Tile Service (M55) -->
        <service
            android:name=".tile.BoxServiceTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_box"
            android:label="@string/tile_service_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Persistent Foreground Status Notification Service (M57) -->
        <service
            android:name=".notification.BoxPersistentNotificationService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent_box_service_status_notification" />
        </service>
    </application>
</manifest>
