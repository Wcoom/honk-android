+                    "digest": format!("sha256:{digest_clone}"),
+                    "browser_download_url": "http://127.0.0.1:1/unused"
+                }]
+            })
+            .to_string();
+            (
+                200,
+                vec![("Content-Type".into(), "application/json".into())],
+                body.into_bytes(),
+            )
