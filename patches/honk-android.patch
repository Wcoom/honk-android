+    let digest = sha256_hex(&binary);
+    let digest_clone = digest.clone();
+    let (addr, server) = spawn_mock_http_server(move |path| match path {
+        "/releases/latest" => {
+            let body = json!({
+                "tag_name": "v99.0.0",
