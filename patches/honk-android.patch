+    let h = handoff as *mut RoutingHandoffEntry;
+    unsafe {
+        core::ptr::write_volatile(core::ptr::addr_of_mut!((*h).last_seen_ns), last_seen_ns);
+        core::ptr::write_volatile(
+            core::ptr::addr_of_mut!((*h).routing_generation),
+            routing_generation,
+        );
+        core::ptr::write_volatile(core::ptr::addr_of_mut!((*h).trace_id), trace_id);
+        core::ptr::write_volatile(core::ptr::addr_of_mut!((*h).trace_padding), 0u32);
+        core::ptr::write_volatile(core::ptr::addr_of_mut!((*h).incarnation), incarnation);
