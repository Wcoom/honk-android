+            tcm_family: 0,
+            tcm_pad1: 0,
+            tcm_pad2: 0,
+            tcm_ifindex: ifindex as i32,
+            tcm_handle: handle,
+            tcm_parent: parent,
+            tcm_info: (u32::from(priority) << 16) | u32::from(ETH_P_ALL.to_be()),
+        };
+        match self.request(RTM_DELTFILTER, NLM_F_REQUEST | NLM_F_ACK, pod_bytes(&header), &[]) {
+            Ok(()) => Ok(()),
+            Err(err)
