+        unsafe { ptr::write_unaligned(dst.add(off) as *mut u16, v) };
+        off += 2;
+    }
+    if off < N {
+        let v = unsafe { ptr::read(src.add(off)) };
+        unsafe { ptr::write(dst.add(off), v) };
+    }
+}
