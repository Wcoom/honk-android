+#[tokio::test]
+async fn udp_exchange_retransmits_after_dropped_packet() {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    let good = IpAddr::V4(Ipv4Addr::new(198, 51, 100, 42));
+    let seen = Arc::new(AtomicUsize::new(0));
+    let seen_clone = Arc::clone(&seen);
+    // Drop the very first A query datagram, answer the retransmit.
+    let server = spawn_udp_stub(move |query| {
+        if qtype(query) == 1 && seen_clone.fetch_add(1, Ordering::AcqRel) == 0 {
+            Vec::new()
+        } else {
+            vec![addr_response(query, &[good])]
+        }
+    })
+    .await;
+    let resolver = BootstrapResolver::parse(&format!("udp://{server}")).unwrap();
+    let ips = resolver.query_family("retransmit.invalid", 1).await.unwrap();
+    assert_eq!(ips, vec![good]);
+    assert!(seen.load(Ordering::Acquire) >= 2);
+}
+
+#[tokio::test]
+async fn fallback_bootstrap_resolver_recovers_when_primary_fails() {
+    if run_global_test_in_child(
+        "bootstrap::tests::fallback_bootstrap_resolver_recovers_when_primary_fails",
+    ) {
+        return;
+    }
+    let good = IpAddr::V4(Ipv4Addr::new(203, 0, 113, 99));
+    // Primary answers empty (NXDOMAIN-like / no records) immediately; fallback answers A.
+    let primary = spawn_udp_stub(|query| vec![addr_response(query, &[])]).await;
+    let fallback = spawn_udp_stub(move |query| vec![addr_response(query, &[good])]).await;
+
+    set_global(BootstrapResolver::parse(&format!("udp://{primary}")));
+    set_global_fallback(BootstrapResolver::parse(&format!("udp://{fallback}")));
+    let ips = resolve("fallback.invalid").await.unwrap();
+    set_global(None);
+    set_global_fallback(None);
+    assert_eq!(ips, vec![good]);
+}
