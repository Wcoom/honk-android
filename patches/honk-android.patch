+// [honk-android] 原地清零，必须躲开 LLVM 的 memset 内建。
+//
+// `zeroed()` / `write_bytes` / 逐字段字面量赋值，LLVM 都会合并成 memset，
+// 最终是"逐字节写"的循环。6.6 的 verifier 把循环计数器当精确标量，每走一圈
+// 就派生一个新状态（0→114 每次都不同），一个 memset 就能吃掉数十万条指令
+// 预算，直接撞上 BPF_COMPLEXITY_LIMIT_INSNS(1M)。
+//
+// 用逐字段 `write_volatile`：volatile 禁止 LLVM 合并/消除，生成常量偏移的
+// 定长 store 序列；且直接写进 &mut self，避免"构造临时值再整体移动"
+// 又被 LLVM 变成 memcpy。
+/// [honk-android] 按对齐字宽逐槽 `write_volatile` 原地清零，严禁触发 `memset` 循环：
+///  * 6.6 verifier 对 `aya_ebpf::memset` 的逐字节循环不合并状态，一次 `memset(72)`
+///    在多分支下会放大几十万条验证指令；
+///  * 也不在栈上构造结构体字面量（节省宝贵的 512B BPF 栈）。
+#[inline(always)]
+pub unsafe fn zero_in_place_volatile<T>(ptr: *mut T) {
+    let base = ptr as *mut u8;
+    let size = core::mem::size_of::<T>();
+    let align = core::mem::align_of::<T>();
+    let mut off = 0usize;
+    unsafe {
+        if align >= 8 {
+            while off + 8 <= size {
+                core::ptr::write_volatile(base.add(off) as *mut u64, 0);
+                off += 8;
+            }
+        }
+        if align >= 4 {
+            while off + 4 <= size {
+                core::ptr::write_volatile(base.add(off) as *mut u32, 0);
+                off += 4;
+            }
+        }
+        if align >= 2 {
+            while off + 2 <= size {
+                core::ptr::write_volatile(base.add(off) as *mut u16, 0);
+                off += 2;
+            }
+        }
+        while off < size {
+            core::ptr::write_volatile(base.add(off), 0);
+            off += 1;
+        }
+    }
+}
