+/// Extract the interface index from Android netd's per-network routing tables
+/// in `/proc/net/fib_trie` (`Id <1000 + ifindex>:` containing `/0 universe UNICAST`).
+pub fn parse_android_netd_default_ifindex(trie: &str) -> Option<u32> {
+    let mut current_table: Option<u32> = None;
+    let mut prev_zero = false;
+    for line in trie.lines() {
+        let trimmed = line.trim();
+        if let Some(rest) = trimmed.strip_prefix("Id ") {
+            current_table = rest.trim_end_matches(':').trim().parse::<u32>().ok();
+            prev_zero = false;
+            continue;
+        }
+        if trimmed == "Main:" || trimmed == "Local:" {
+            current_table = None;
+            prev_zero = false;
+            continue;
+        }
+        if let Some(table_id) = current_table
+            && (1001..2000).contains(&table_id)
+        {
+            if trimmed == "|-- 0.0.0.0" {
+                prev_zero = true;
+            } else if prev_zero && trimmed.starts_with("/0 universe UNICAST") {
+                return Some(table_id - 1000);
+            } else {
+                prev_zero = false;
+            }
+        }
+    }
+    None
+}
